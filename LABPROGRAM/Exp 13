import pandas as pd
from sklearn.linear_model import LinearRegression

data = {
    'Age': [1, 2, 3, 4, 5, 2, 6, 3, 1, 5],
    'Mileage': [10000, 20000, 30000, 40000, 50000,
               25000, 60000, 35000, 12000, 55000],
    'Price': [900000, 800000, 700000, 600000, 500000,
              760000, 420000, 680000, 880000, 450000]
}

df = pd.DataFrame(data)

X = df[['Age', 'Mileage']]
y = df['Price']

model = LinearRegression()
model.fit(X, y)

print("Model Coefficients:", model.coef_)
print("Intercept:", model.intercept_)

new_car = [[3, 28000]]
print("Predicted Car Price:", model.predict(new_car)[0])
